# ---- Olagon AI Gateway (third-party proxy, Anthropic-compatible format) ----
# Kunci API Proxy Klien dari dashboard Olagon, format rk_live_...
OLAGON_API_KEY=rk_live_xxxxxxxxxxxxxxxxxxxxxxxx
OLAGON_BASE_URL=https://gateway.olagon.site/anthropic
OLAGON_MODEL=claude-sonnet-4-6

# ---- NextAuth ----
# openssl rand -base64 32
NEXTAUTH_SECRET=
# ganti ke domain production saat deploy
NEXTAUTH_URL=http://localhost:3000

# ---- Demo user (ganti ke database asli untuk multi-user) ----
# Setelan di bawah ini = login  user / user, tanpa perlu bikin hash sama sekali.
# Di `npm run dev`, user/user tetap jalan walau dua baris ini dikosongkan.
# Di production (termasuk Vercel) keduanya WAJIB diisi.
DEMO_USER_EMAIL=user
DEMO_USER_PASSWORD=user

# Alternatif yang lebih aman: hash bcrypt. Kalau baris ini diisi dengan hash yang
# valid, hash yang dipakai dan DEMO_USER_PASSWORD di atas diabaikan.
# Buat dengan: node scripts/hash-password.js "kata-sandi-baru"
# PENTING: di file .env, tanda $ pada hash WAJIB di-escape jadi \$ — Next.js
# memakai dotenv-expand, jadi $2a/$12 yang tidak di-escape dibaca sebagai
# variabel dan hash-nya jadi kosong (login selalu gagal). Kutip tunggal tidak
# menolong. Di dashboard/CLI Vercel, tempel hash MENTAH tanpa escape.
# DEMO_USER_PASSWORD_HASH=

# ---- Diagnostik login (opsional) ----
# /api/auth-status selalu bisa diakses dan melaporkan apa saja yang sudah diset.
# Bagian yang menjelaskan BENTUK username/password (panjang, huruf kecil semua,
# dsb.) hanya keluar di luar production, atau di production kalau permintaannya
# membawa token ini: /api/auth-status?token=<nilai>. Dikosongkan = bagian itu
# tidak pernah keluar di production. Buat dengan: openssl rand -hex 16
# AUTH_STATUS_TOKEN=

# ---- Builder Python ----
# Lokal: kosongkan saja, /api/generate menjalankan python3 sendiri.
# Interpreter yang dipakai (opsional, default python3):
# PYTHON_BIN=python3
#
# Vercel / hosting tanpa python3: builder berjalan sebagai fungsi terpisah.
# INTERNAL_API_SECRET WAJIB diisi di sana — fungsi Python menolak permintaan
# tanpa header secret ini. Buat dengan: openssl rand -hex 32
# INTERNAL_API_SECRET=
#
# Kosongkan di Vercel: route otomatis memakai /api/build di deployment yang sama.
# Isi hanya kalau builder Python di-deploy terpisah (Railway/Render/Fly.io):
# PYTHON_SERVICE_URL=https://panel-python.up.railway.app/api/build
