# ---- Olagon AI Gateway (third-party proxy, Anthropic-compatible format) ----
# Kunci API Proxy Klien dari dashboard Olagon, format rk_live_...
OLAGON_API_KEY=rk_live_xxxxxxxxxxxxxxxxxxxxxxxx
OLAGON_BASE_URL=https://gateway.olagon.site/anthropic
OLAGON_MODEL=claude-sonnet-4-6

# ---- NextAuth ----
# openssl rand -base64 32
NEXTAUTH_SECRET=
# ganti ke domain production saat deploy
NEXTAUTH_URL=http://localhost:3000

# ---- Demo user (ganti ke database asli untuk multi-user) ----
# Nilai di bawah ini = login  user / user  (hash bcrypt dari kata "user").
# Kalau kedua baris ini dikosongkan, saat `npm run dev` login user/user tetap
# jalan lewat fallback di lib/auth.ts. Di production keduanya WAJIB diisi.
DEMO_USER_EMAIL=user
# Ganti dengan: node scripts/hash-password.js "kata-sandi-baru"
# PENTING: di file .env, tanda $ pada hash bcrypt WAJIB di-escape jadi \$ —
# Next.js memakai dotenv-expand, jadi $2a/$12 yang tidak di-escape dibaca sebagai
# variabel dan hash-nya jadi kosong (login selalu gagal). Kutip tunggal tidak menolong.
# Skrip hash-password.js sudah mencetak baris yang siap tempel.
# Di dashboard Vercel, tempel hash MENTAH tanpa escape.
DEMO_USER_PASSWORD_HASH=\$2a\$12\$roIArRjMh9dsdRug21gCqOSD1/7IrGBnnSJ3ZalMTsUwUyJQwp.t6

# ---- Opsional ----
# Interpreter Python untuk /api/generate. Default: python3
# PYTHON_BIN=python3
