{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/build.py": {
      "runtime": "@vercel/python@4.3.1",
      "memory": 1769,
      "maxDuration": 60,
      "includeFiles": "python/**"
    },
    "app/api/generate/route.ts": {
      "maxDuration": 60
    },
    "app/api/extract/route.ts": {
      "maxDuration": 60
    }
  }
}
